# Copy to .env and fill in. Never commit .env.
# UMLS Terminology Services key (https://uts.nlm.nih.gov/uts/profile)
UMLS_API_KEY=
# Optional LLM adjudication (off by default). Providers: none | gemini | openai_compat
LLM_PROVIDER=none
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# For a self-hosted OpenAI-compatible server (vLLM, llama.cpp, Ollama)
OPENAI_COMPAT_BASE_URL=http://localhost:8000/v1
OPENAI_COMPAT_MODEL=
OPENAI_COMPAT_API_KEY=
# Data locations (defaults are the repo root files)
TERMMAP_TRAIN=hackathon_train.csv
TERMMAP_ICD_XLSX=icd10cm_codes.xlsx
TERMMAP_SNOMED_XLSX=SNOMEDCT_US_codes_and_descriptions.xlsx
TERMMAP_CACHE=data/cache
