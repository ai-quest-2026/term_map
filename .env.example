# Copy to .env and fill in. Never commit .env. Nothing here is required for the shipped engine.

# Data locations (defaults are the repo-root files)
TERMMAP_TRAIN=hackathon_train.csv
TERMMAP_ICD_XLSX=icd10cm_codes.xlsx
TERMMAP_SNOMED_XLSX=SNOMEDCT_US_codes_and_descriptions.xlsx
TERMMAP_CACHE=data/cache

# Engine switches (defaults = shipped configuration)
# TERMMAP_SAPBERT=1        # 0 disables SapBERT retrieval (CPU-only machines)
# TERMMAP_CE=auto          # cross-encoder on when a GPU is present; off to skip
# TERMMAP_CE_K=30
# TERMMAP_CE_EPOCHS=4
# TERMMAP_STACKER=1        # 0 ignores the exported stacker
# TERMMAP_JOBS=4           # LightGBM threads
# TERMMAP_PROGRESS=        # print a heartbeat every N terms

# UMLS Terminology Services key (optional lookups via /external/umls/*, never used at inference)
UMLS_API_KEY=

# API LLM mode, used only with `scripts.predict --llm`. Providers: none | gemini | openai_compat
# Never send chart text to an API that retains prompts: prefer a self-hosted openai_compat server.
LLM_PROVIDER=none
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_COMPAT_BASE_URL=http://localhost:8000/v1
OPENAI_COMPAT_MODEL=
OPENAI_COMPAT_API_KEY=

# Side experiment only (scripts/llm_sidecar.py, TypeSafe Jev), not part of the engine
JEV_API_KEY=
